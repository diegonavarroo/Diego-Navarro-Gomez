-- Script 1: Creación de la base de datos
DROP DATABASE IF EXISTS base_de_datos_premier_league;

CREATE DATABASE base_de_datos_premier_league
    WITH
    OWNER = postgres
    ENCODING = 'UTF8'
    LC_COLLATE = 'English_United States.1252'
    LC_CTYPE = 'English_United States.1252'
    LOCALE_PROVIDER = 'libc'
    TABLESPACE = pg_default
    CONNECTION LIMIT = -1
    IS_TEMPLATE = False;
